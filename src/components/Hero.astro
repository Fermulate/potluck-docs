---
// Landing hero, drawn like the app's balance card: an ink slip with a ticket edge.
// In dark mode it turns into a lit paper slip, as it does in the app.
import Screenshot from './Screenshot.astro'

const { data } = Astro.locals.starlightRoute.entry
const hero = data.hero
const title = hero?.title ?? data.title
const tagline = hero?.tagline
const actions = hero?.actions ?? []
// The not-found page borrows the slip but has no screen to show.
const withPhone = Astro.locals.starlightRoute.entry.id !== '404'
---

<section class:list={['pl-hero not-content', !withPhone && 'pl-hero--plain']} aria-labelledby="_top">
  <div class="pl-hero__text">
    <h1 id="_top" set:html={title} />
    {tagline && <p class="pl-hero__tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="pl-hero__actions">
          {actions.map((a, i) => (
            <a
              href={a.link}
              class:list={['pl-btn', i === 0 ? 'pl-btn--primary' : 'pl-btn--ghost']}
              {...a.attrs}
            >
              {a.text}
            </a>
          ))}
        </div>
      )
    }
  </div>
  {
    withPhone && (
      <div class="pl-hero__phone">
        <Screenshot
          name="home"
          alt="Potluck's Home screen on a phone: a greeting, a balance card reading All told, you owe $35.10, and a Needs you card asking about Saturday's dinner."
        />
      </div>
    )
  }
</section>

<style>
  .pl-hero {
    position: relative;
    display: grid;
    gap: 2rem;
    margin-top: 1rem;
    padding: 2.25rem 1.5rem 2.75rem;
    background: var(--pl-hero);
    color: var(--pl-on-hero);
    border-radius: 1.75rem 1.75rem 0 0;
    /* The ticket edge: half-circle bites along the bottom. */
    -webkit-mask:
      radial-gradient(circle at 50% 100%, transparent 7px, #000 7.5px) bottom / 20px 14px repeat-x,
      linear-gradient(#000, #000) top / 100% calc(100% - 14px) no-repeat;
    mask:
      radial-gradient(circle at 50% 100%, transparent 7px, #000 7.5px) bottom / 20px 14px repeat-x,
      linear-gradient(#000, #000) top / 100% calc(100% - 14px) no-repeat;
    overflow: hidden;
  }

  h1 {
    margin: 0;
    font-family: var(--pl-font-display);
    font-weight: 400;
    font-size: clamp(3.25rem, 2.25rem + 5vw, 5.75rem);
    line-height: 0.9;
    letter-spacing: -0.015em;
    color: var(--pl-on-hero);
    text-wrap: balance;
  }

  .pl-hero__tagline {
    margin: 1.25rem 0 0;
    max-width: 30rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--pl-hero-mute);
  }

  .pl-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .pl-btn {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1.0625rem;
    text-decoration: none;
    transition: transform 150ms ease;
  }
  .pl-btn:active {
    transform: scale(0.97);
  }
  .pl-btn--primary {
    background: var(--pl-hero-action);
    color: var(--pl-on-hero-action);
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.18);
  }
  .pl-btn--primary:hover {
    background: color-mix(in srgb, var(--pl-hero-action) 90%, #000);
  }
  .pl-btn--ghost {
    color: var(--pl-on-hero);
    border: 1.5px solid color-mix(in srgb, var(--pl-on-hero) 30%, transparent);
  }
  .pl-btn--ghost:hover {
    border-color: var(--pl-on-hero);
  }
  .pl-btn:focus-visible {
    outline: 2px solid var(--pl-on-hero);
    outline-offset: 3px;
  }

  .pl-hero__phone {
    justify-self: center;
    width: min(15rem, 80%);
    margin-bottom: -6rem;
    transform: rotate(2.5deg);
  }
  .pl-hero__phone :global(.pl-shot) {
    margin: 0;
  }

  .pl-hero--plain {
    padding-bottom: 3.25rem;
  }

  @media (min-width: 50rem) {
    .pl-hero {
      align-items: start;
      padding: 3.5rem 3rem 3.5rem;
      column-gap: 3rem;
    }
    .pl-hero:not(.pl-hero--plain) {
      grid-template-columns: minmax(0, 1fr) 17rem;
    }
    .pl-hero__phone {
      width: 100%;
      margin-bottom: -9rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .pl-hero__phone {
      animation: pl-settle 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes pl-settle {
      from {
        transform: translateY(1.5rem) rotate(6deg);
        opacity: 0;
      }
      to {
        transform: rotate(2.5deg);
        opacity: 1;
      }
    }
  }
</style>
