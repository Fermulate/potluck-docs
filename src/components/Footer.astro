---
// Starlight's footer (edit link, prev and next), then the project links.
import Default from '@astrojs/starlight/components/Footer.astro'
---

<Default><slot /></Default>

<div class="pl-footer">
  <a class="pl-footer__open" href="https://potluck.potluck-web.workers.dev">Open Potluck</a>
  <ul>
    <li><a href="https://github.com/Fermulate/potluck">Source code on GitHub</a></li>
    <li>
      <a href="https://github.com/Fermulate/potluck/blob/main/LICENSE">Free software under the AGPL-3.0</a>
    </li>
    <li>
      <a href="https://github.com/Fermulate/potluck-docs">Improve this guide</a>
    </li>
  </ul>
  <p>Guide text licensed under CC BY-SA 4.0.</p>
</div>

<style>
  .pl-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--pl-line);
    font-size: var(--sl-text-sm);
    color: var(--pl-mute);
  }
  .pl-footer__open {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 1.1rem;
    border-radius: 999px;
    background: var(--pl-ink);
    color: var(--pl-paper);
    font-weight: 700;
    text-decoration: none;
  }
  .pl-footer__open:hover {
    background: var(--pl-tomato-ink);
    color: #fff;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    color: var(--pl-mute);
    text-underline-offset: 0.2em;
  }
  ul a:hover {
    color: var(--pl-ink);
  }
  p {
    flex-basis: 100%;
    margin: 0;
    font-size: var(--sl-text-xs);
  }
</style>
