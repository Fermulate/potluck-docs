---
/**
 * The guide's version of the app's first steps card on Home ("Set the table"): the same three
 * steps in the same words, each one a link to the page that explains it. The gingham strip is
 * the app's tablecloth, and this card is the only place the guide uses it.
 */
interface Props {
  /** Heading level for the card title, so it fits the page outline. */
  as?: 'h2' | 'h3'
  /** Adds a line for readers who have not signed up yet. */
  signUpHint?: boolean
}

const { as: Heading = 'h2', signUpHint = false } = Astro.props

const steps = [
  {
    title: 'Start a group',
    hint: 'Roommates, a trip, the dinner crew.',
    href: '/groups/#create-a-group',
  },
  {
    title: 'Add your people',
    hint: 'Send an invite link, or add someone by name.',
    href: '/groups/invites/',
  },
  {
    title: 'Add the first expense',
    hint: 'Potluck works out who owes what.',
    href: '/expenses/#add-an-expense',
  },
]
---

<section class="pl-first not-content" aria-labelledby="pl-first-title">
  <div class="pl-first__cloth" aria-hidden="true"></div>
  <div class="pl-first__body">
    <Heading id="pl-first-title" class="pl-first__title">Set the table</Heading>
    <p class="pl-first__lede">Three small steps and Potluck starts keeping the tab.</p>
    <ol>
      {
        steps.map((step, i) => (
          <li>
            <a href={step.href}>
              <span class="pl-first__num" aria-hidden="true">
                {i + 1}
              </span>
              <span class="pl-first__text">
                <span class="pl-first__step">{step.title}</span>
                <span class="pl-first__hint">{step.hint}</span>
              </span>
              <svg class="pl-first__go" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 6 6 6-6 6" />
              </svg>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  {
    signUpHint && (
      <p class="pl-first__foot">
        No account yet? <a href="/getting-started/#create-an-account">Create one first</a>, it takes a minute.
      </p>
    )
  }
</section>

<style>
  .pl-first {
    overflow: hidden;
    border: 1px solid var(--pl-line);
    border-radius: var(--pl-radius-card);
    background: var(--pl-card);
    color: var(--pl-ink);
  }
  .pl-first__cloth {
    height: 0.75rem;
    border-bottom: 1px solid var(--pl-line);
    background-color: var(--pl-paper);
    background-image:
      linear-gradient(90deg, color-mix(in oklab, var(--pl-tomato) 42%, transparent) 50%, transparent 50%),
      linear-gradient(color-mix(in oklab, var(--pl-tomato) 42%, transparent) 50%, transparent 50%);
    background-size: 12px 12px;
  }
  .pl-first__body {
    padding: 1.25rem 1.25rem 0.5rem;
  }
  .pl-first__title {
    margin: 0;
    font-family: var(--pl-font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--pl-ink);
  }
  .pl-first__lede {
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--pl-mute);
  }
  ol {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  li + li {
    border-top: 1px solid var(--pl-line);
  }
  li a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-inline: -0.6rem;
    padding: 0.8rem 0.6rem;
    border-radius: var(--pl-radius-input);
    color: inherit;
    text-decoration: none;
  }
  li a:hover {
    background: var(--pl-sunken);
  }
  .pl-first__num {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: var(--pl-tomato-strong);
    color: var(--pl-on-tomato);
    font-size: var(--sl-text-sm);
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }
  .pl-first__text {
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.35;
  }
  .pl-first__step {
    font-weight: 650;
  }
  li a:hover .pl-first__step {
    text-decoration: underline;
    text-decoration-color: var(--pl-tomato);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
  .pl-first__hint {
    font-size: var(--sl-text-sm);
    color: var(--pl-mute);
  }
  .pl-first__go {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--pl-mute);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pl-first__foot {
    margin: 0;
    padding: 0.8rem 1.25rem;
    border-top: 1px solid var(--pl-line);
    font-size: var(--sl-text-sm);
    color: var(--pl-mute);
  }
  .pl-first__foot a {
    color: var(--pl-ink);
    font-weight: 650;
    text-decoration-color: var(--pl-tomato);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
</style>
